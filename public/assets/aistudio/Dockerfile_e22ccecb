FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Instalar as bibliotecas incluindo o driver do postgresql
RUN pip install --no-cache-dir fastapi uvicorn google-genai python-dotenv pydantic sqlalchemy psycopg2-binary

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]